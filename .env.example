DB_HOST=localhost
DB_PORT=5434
POSTGRES_DB=listryx
POSTGRES_USER=listryx
POSTGRES_PASSWORD=listryx

HTTP_HOST=127.0.0.1
HTTP_PORT=8088

KEYCLOAK_ISSUER_URI=http://localhost:8089/auth/realms/listryx
# Only when the keys are not reachable at the issuer, e.g. from inside a container.
# KEYCLOAK_JWKS_URI=http://keycloak:8080/auth/realms/listryx/protocol/openid-connect/certs

# The other direction: the API calling the Admin API for /api/me. In production the server URL is
# the admin vhost, since listryx.com returns 404 for /auth/admin/, and the secret is the one the
# auth repo imported the `listryx-api-admin` client with.
KEYCLOAK_SERVER_URL=http://localhost:8089/auth
KEYCLOAK_REALM=listryx
KEYCLOAK_ADMIN_CLIENT_ID=listryx-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=local-dev-secret

LISTRYX_CORS_ORIGINS=http://localhost:4201
LISTRYX_DEFAULT_CURRENCY=BRL

LOG_LEVEL=info
LOG_PRETTY=false
